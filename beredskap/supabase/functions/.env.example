# Secrets for the edge functions. Copy to .env in this folder (gitignored).
# For a hosted project, set them with:  npx supabase secrets set KEY=value
#
# DEMO_MODE turns on the demo-login function. NEVER set it on a production project.
DEMO_MODE=true
# The code you share in the meeting (at least 8 characters).
DEMO_ACCESS_CODE=
# The password of the demo users (same as DEMO_PASSWORD in beredskap/.env).
DEMO_PASSWORD=
# Origins allowed to call the functions from a browser (comma separated).
# ALLOWED_ORIGINS=https://skyddsrum.se
