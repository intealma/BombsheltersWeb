{
  "name": "beredskap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Login-gated shelter readiness tool for skyddsrum.se (owners, länsstyrelser, kommuner).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && node scripts/seed-users.mjs",
    "seed:users": "node scripts/seed-users.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/nunito-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "jspdf": "^4.2.1",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "supabase": "^2.121.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
