# Copy to .env (gitignored) and fill in. Never commit .env.
#
# Local development: run `npx supabase status` after `npm run db:start` and
# copy the API URL and the anon key from there. Scripts and tests find the
# local service role key themselves, so leave SUPABASE_* empty locally.

# --- Browser (bundled into the app, so public values only) -----------------
# Anything starting with VITE_ is shipped to every visitor. The build refuses
# to run if a secret key is put here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Shows the DEMO badge on every screen.
VITE_DEMO_MODE=true

# --- Node scripts only (seed, reset, tests). Never prefix with VITE_. -------
# Leave empty for the local stack. Set them only to seed a hosted project.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Password for every fictional demo user created by `npm run seed:users`.
# At least 12 characters with lower case, upper case and digits.
DEMO_PASSWORD=

# Access code for the demo role switcher. Share it in the meeting, not in writing.
# Must match DEMO_ACCESS_CODE in supabase/functions/.env.
DEMO_ACCESS_CODE=
